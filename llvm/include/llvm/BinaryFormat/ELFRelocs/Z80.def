
#ifndef ELF_RELOC
#error "ELF_RELOC must be defined"
#endif

// Relocation types for Z80 ELF files, with the numbers and meanings GNU
// binutils gives them.

ELF_RELOC(R_Z80_NONE,     0)

// An 8-bit value. An SM83 LDH operand uses it with the full high-page address.
ELF_RELOC(R_Z80_8,        1)

// An 8-bit signed displacement for indexed addressing (IX+d, IY+d).
ELF_RELOC(R_Z80_8_DIS,    2)

// An 8-bit PC-relative displacement (JR, DJNZ), measured from the relocated
// byte; the assembler puts the instruction-end adjustment in the addend.
ELF_RELOC(R_Z80_8_PCREL,  3)

ELF_RELOC(R_Z80_16,       4)
ELF_RELOC(R_Z80_24,       5)
ELF_RELOC(R_Z80_32,       6)

// Single bytes of a value, from the least significant one.
ELF_RELOC(R_Z80_BYTE0,    7)
ELF_RELOC(R_Z80_BYTE1,    8)
ELF_RELOC(R_Z80_BYTE2,    9)
ELF_RELOC(R_Z80_BYTE3,    10)

// The low and high 16 bits of a value.
ELF_RELOC(R_Z80_WORD0,    11)
ELF_RELOC(R_Z80_WORD1,    12)

// A big-endian 16-bit value (Z80N PUSH nn).
ELF_RELOC(R_Z80_16_BE,    13)
