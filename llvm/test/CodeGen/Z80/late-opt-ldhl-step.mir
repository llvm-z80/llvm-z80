# RUN: llc -verify-machineinstrs -mtriple=sm83 -run-pass=z80-late-opt %s -o - | FileCheck %s
#
# Stepping the address the previous LDHL SP produced, instead of loading the
# adjacent one, reads HL past the point where it was free to die.

--- |
  define void @step_past_kill() { ret void }
...
---
name:            step_past_kill
tracksRegLiveness: true
stack:
  - { id: 0, size: 2, alignment: 1 }
body:             |
  bb.0:
    liveins: $sp
    LDHL_SP_e 0, implicit-def $hl, implicit-def $flags, implicit $sp
    $e = LD_r_HLind implicit killed $hl :: (volatile load (s8) from %stack.0)
    $c = LD_r_n 5
    LDHL_SP_e 1, implicit-def $hl, implicit-def $flags, implicit $sp
    $d = LD_r_HLind implicit killed $hl :: (volatile load (s8) from %stack.0 + 1)
    RET implicit $de, implicit $c
...
---
# CHECK-LABEL: name: step_past_kill
# CHECK:      $e = LD_r_HLind implicit $hl
# CHECK:      $hl = INC_rr killed $hl
