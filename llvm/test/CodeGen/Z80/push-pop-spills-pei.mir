# RUN: llc -verify-machineinstrs -mtriple=z80 -run-pass=prolog-epilog %s -o - | FileCheck %s
#
# SPAdj does not count SPILL_PUSH and SPILL_POP. eliminateFrameIndex and the
# debug value fixup count the pseudos before an SP-relative access in the same
# block.

--- |
  define void @under_push() { ret void }
  define void @call_under_push() { ret void }
  define void @debug_under_push() !dbg !3 { ret void }
  declare void @f(i8)

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2}
  !0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, isOptimized: true, emissionKind: FullDebug)
  !1 = !DIFile(filename: "t.c", directory: "/")
  !2 = !{i32 2, !"Debug Info Version", i32 3}
  !3 = distinct !DISubprogram(name: "debug_under_push", scope: !1, file: !1, line: 1, type: !4, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !4 = !DISubroutineType(types: !5)
  !5 = !{null}
  !6 = !DILocalVariable(name: "a", arg: 1, scope: !3, file: !1, line: 1, type: !7)
  !7 = !DIBasicType(name: "int", size: 16, encoding: DW_ATE_signed)
  !8 = !DILocation(line: 0, scope: !3)
...
---
# The stack argument is at SP+2 on entry, SP+4 under the push, and SP+2 again
# after the pop.
# CHECK-LABEL: name: under_push
# CHECK:       SPILL_PUSH killed $de
# CHECK-NEXT:  $hl = LD_rr_nn 4
# CHECK-NEXT:  ADD_HL_SP
# CHECK-NEXT:  $c = LD_r_HLind
# CHECK-NEXT:  $de = SPILL_POP
# CHECK-NEXT:  $hl = LD_rr_nn 2
# CHECK-NEXT:  ADD_HL_SP
# CHECK-NEXT:  $b = LD_r_HLind
name:            under_push
tracksRegLiveness: true
fixedStack:
  - { id: 0, offset: 2, size: 1, alignment: 1, isImmutable: true }
body:             |
  bb.0:
    liveins: $de
    SPILL_PUSH killed $de
    $c = RELOAD_GR8 %fixed-stack.0, 0 :: (load (s8) from %fixed-stack.0)
    $de = SPILL_POP
    $b = RELOAD_GR8 %fixed-stack.0, 0 :: (load (s8) from %fixed-stack.0)
    RET implicit $bc, implicit $de
...
---
# Inside a call sequence, SPAdj counts the argument PUSH and the SPILL_PUSH
# is added on top: SP+2 on entry becomes SP+6.
# CHECK-LABEL: name: call_under_push
# CHECK:       PUSH_HL implicit killed $hl
# CHECK-NEXT:  $hl = LD_rr_nn 6
# CHECK-NEXT:  ADD_HL_SP
# CHECK-NEXT:  $c = LD_r_HLind
name:            call_under_push
tracksRegLiveness: true
frameInfo:
  adjustsStack:    true
  hasCalls:        true
fixedStack:
  - { id: 0, offset: 2, size: 1, alignment: 1, isImmutable: true }
body:             |
  bb.0:
    liveins: $de, $hl
    SPILL_PUSH killed $de
    ADJCALLSTACKDOWN 2, 0, implicit-def $sp, implicit $sp
    PUSH_HL implicit killed $hl
    $c = RELOAD_GR8 %fixed-stack.0, 0 :: (load (s8) from %fixed-stack.0)
    CALL_nn @f, implicit-def dead $a, implicit-def dead $hl, implicit-def $iy, implicit-def $flags, implicit $c
    ADJCALLSTACKUP 2, 2, implicit-def $sp, implicit $sp
    $de = SPILL_POP
    RET implicit $de
...
---
# A debug value in a spill slot gets the pushed bytes added under the push.
# The direct form under the push loses the location.
# CHECK-LABEL: name: debug_under_push
# CHECK:       DBG_VALUE $sp, 0, !6, !DIExpression(),
# CHECK-NEXT:  SPILL_PUSH killed $de
# CHECK-NEXT:  DBG_VALUE $sp, 0, !6, !DIExpression(DW_OP_plus_uconst, 2),
# CHECK-NEXT:  DBG_VALUE $noreg, $noreg, !6, !DIExpression(),
name:            debug_under_push
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 2, alignment: 1 }
body:             |
  bb.0:
    liveins: $de, $hl
    SPILL_GR16 killed $hl, %stack.0, 0 :: (store (s16) into %stack.0, align 1)
    DBG_VALUE %stack.0, 0, !6, !DIExpression(), debug-location !8
    SPILL_PUSH killed $de
    DBG_VALUE %stack.0, 0, !6, !DIExpression(), debug-location !8
    DBG_VALUE %stack.0, $noreg, !6, !DIExpression(), debug-location !8
    $de = SPILL_POP
    RET implicit $de
...
