# RUN: llc -verify-machineinstrs -mtriple=z80 -run-pass=z80-pre-emit-peephole %s -o - | FileCheck %s
#
# A value stored to a frame slot can answer a later load from it, but only
# when the program did not ask for the access to happen. The memory operand
# is what says which, so it has to survive selection and expansion to get
# here.

--- |
  define void @spill_forwards() { ret void }
  define void @volatile_kept() { ret void }
  define void @pointer_store_kept() { ret void }
...
---
name:            spill_forwards
tracksRegLiveness: true
stack:
  - { id: 0, size: 1, alignment: 1 }
body:             |
  bb.0:
    liveins: $c, $ix
    LD_IXd_r -2, $c, implicit $ix :: (store (s8) into %stack.0)
    $l = LD_r_IXd -2, implicit $ix :: (load (s8) from %stack.0)
    RET implicit $l

# CHECK-LABEL: name: spill_forwards
# CHECK:      LD_IXd_r -2, $c
# CHECK-NEXT: $l = LD_r_r killed $c
# CHECK-NEXT: RET

...
---
name:            volatile_kept
tracksRegLiveness: true
stack:
  - { id: 0, size: 1, alignment: 1 }
body:             |
  bb.0:
    liveins: $c, $ix
    LD_IXd_r -2, $c, implicit $ix :: (volatile store (s8) into %stack.0)
    $l = LD_r_IXd -2, implicit $ix :: (volatile load (s8) from %stack.0)
    RET implicit $l

# CHECK-LABEL: name: volatile_kept
# CHECK:      LD_IXd_r -2, $c
# CHECK-NEXT: $l = LD_r_IXd -2
# CHECK-NEXT: RET

...
---
name:            pointer_store_kept
tracksRegLiveness: true
stack:
  - { id: 0, size: 1, alignment: 1 }
body:             |
  bb.0:
    liveins: $a, $c, $de, $ix
    LD_IXd_r -2, $c, implicit $ix :: (store (s8) into %stack.0)
    LD_DEind_A implicit $de, implicit $a
    $l = LD_r_IXd -2, implicit $ix :: (load (s8) from %stack.0)
    RET implicit $l

# A store through a pointer may write the slot, so the load stays.
# CHECK-LABEL: name: pointer_store_kept
# CHECK:      LD_IXd_r -2, $c
# CHECK-NEXT: LD_DEind_A
# CHECK-NEXT: $l = LD_r_IXd -2
# CHECK-NEXT: RET

...
