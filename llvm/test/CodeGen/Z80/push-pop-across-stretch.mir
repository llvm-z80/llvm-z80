# RUN: llc -verify-machineinstrs -mtriple=sm83 -run-pass=z80-pre-emit-peephole %s -o - | FileCheck %s
#
# A pair saved across a stretch that never writes it is saved for nothing.
# What the stack accesses in between were addressed with is the two bytes the
# save took, so taking two off each displacement puts them back.

--- |
  define void @rebase() { ret void }
  define void @hl_needs_the_pop() { ret void }
  define void @pop_push_rebase() { ret void }
...
---
name:            rebase
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $bc, $sp
    PUSH_BC implicit $c, implicit $b, implicit-def $sp, implicit $sp
    LDHL_SP_e 6, implicit-def $hl, implicit-def $f, implicit $sp
    $a = LD_r_HLind implicit $hl
    POP_BC implicit-def $c, implicit-def $b, implicit-def $sp, implicit $sp
    RET implicit $bc, implicit $a

# CHECK-LABEL: name: rebase
# CHECK-NOT:  PUSH_BC
# CHECK:      LDHL_SP_e 4
# CHECK-NEXT: $a = LD_r_HLind
# CHECK-NEXT: RET

...
---
name:            hl_needs_the_pop
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $hl, $sp
    PUSH_HL implicit $l, implicit $h, implicit-def $sp, implicit $sp
    LDHL_SP_e 6, implicit-def $hl, implicit-def $f, implicit $sp
    $a = LD_r_HLind implicit $hl
    POP_HL implicit-def $l, implicit-def $h, implicit-def $sp, implicit $sp
    RET implicit $hl, implicit $a

# The stack access writes HL, so when HL is what was saved the pop is the
# only thing putting it back.

# CHECK-LABEL: name: hl_needs_the_pop
# CHECK:      PUSH_HL
# CHECK:      POP_HL

...
---
name:            pop_push_rebase
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $sp
    POP_BC implicit-def $c, implicit-def $b, implicit-def $sp, implicit $sp
    LDHL_SP_e 4, implicit-def $hl, implicit-def $f, implicit $sp
    $a = LD_r_HLind implicit $hl
    PUSH_BC implicit $c, implicit $b, implicit-def $sp, implicit $sp
    RET implicit $a

# POP ... PUSH: the pair stays on the stack and LDHL SP,e moves to e+2.

# CHECK-LABEL: name: pop_push_rebase
# CHECK-NOT:  POP_BC
# CHECK:      LDHL_SP_e 6
# CHECK-NEXT: $a = LD_r_HLind
# CHECK-NEXT: RET

...
