# RUN: llc -mtriple=z80 -run-pass=z80-late-opt %s -o - | FileCheck %s

# Lowering a pair copy leaves every implicit def the copy carried on the last
# byte move, so a move can claim to write the byte its predecessor wrote. A
# liveness query must not read such a def as the place the write happens.

---
# CHECK-LABEL: name: undeclared_def_not_trusted
# CHECK: POP_DE
# CHECK: PUSH_DE
name:            undeclared_def_not_trusted
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $bc, $sp
    POP_DE implicit-def $de, implicit-def $sp, implicit $sp
    LD_A_B implicit-def $a, implicit $b
    PUSH_DE implicit $de, implicit-def $sp, implicit $sp
    LD_D_B implicit-def $d, implicit $b, implicit-def $e
    RET implicit $de
...
---
# CHECK-LABEL: name: declared_def_trusted
# CHECK-NOT: POP_DE
# CHECK-NOT: PUSH_DE
name:            declared_def_trusted
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $bc, $sp
    POP_DE implicit-def $de, implicit-def $sp, implicit $sp
    LD_A_B implicit-def $a, implicit $b
    PUSH_DE implicit $de, implicit-def $sp, implicit $sp
    LD_E_C implicit-def $e, implicit $c
    LD_D_B implicit-def $d, implicit $b
    RET implicit $de
...
