# RUN: llc -mtriple=z80 -run-pass=z80-fixup-implicit-defs %s -o - | FileCheck %s
#
# Lowering a pair copy leaves every implicit def the copy carried on the last
# byte move, so a move can claim to write the byte its predecessor wrote. The
# claim is dropped here, before anything reads liveness off it.

---
# CHECK-LABEL: name: relocated_def_removed
# CHECK:      $e = LD_r_r $c
# CHECK-NEXT: $d = LD_r_r $b, implicit-def $d
# CHECK-NEXT: RET
name:            relocated_def_removed
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $bc
    $e = LD_r_r $c
    $d = LD_r_r $b, implicit-def $e, implicit-def $d
    RET implicit $de
...
---
# A byte widened to a pair leaves the upper half unwritten and says so with a
# def nothing else makes. Dropping that one would leave the pair undefined.
# CHECK-LABEL: name: undefined_half_kept
# CHECK: $l = LD_r_r $a, implicit-def $h
name:            undefined_half_kept
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $a
    $l = LD_r_r $a, implicit-def $h
    RET implicit $hl
...
