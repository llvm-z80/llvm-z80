# RUN: llc -verify-machineinstrs -mtriple=z80 -run-pass=z80-branch-cleanup %s -o - \
# RUN:   | FileCheck %s

---
# Both branches of bb.0 go to a block with only a RET. Only bb.0 reaches
# bb.2, which is erased. The JR at the end of bb.1 then goes to the next block.
# CHECK-LABEL: name: two_branches
# CHECK:       bb.0:
# CHECK-NEXT:    successors: %bb.1(
# CHECK:         RET_Z implicit $flags
# CHECK-NEXT:    RET_C implicit $flags
# CHECK:       bb.1:
# CHECK:         $a = LD_r_r $l
# CHECK-NOT:     JR_e
# CHECK-NOT:   bb.2:
# CHECK:       bb.3:
# CHECK-NEXT:    RET
name: two_branches
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.3, %bb.2, %bb.1
    liveins: $a, $l

    OR_r $a, implicit-def $a, implicit-def $flags, implicit $a
    JR_Z_e %bb.3, implicit $flags
    JR_C_e %bb.2, implicit $flags

  bb.1:
    successors: %bb.3
    liveins: $l

    $a = LD_r_r $l
    JR_e %bb.3

  bb.2:
    RET

  bb.3:
    RET
...
---
# The branch over a block with only a tail call takes the call under the
# opposite condition.
# CHECK-LABEL: name: over_tail_call
# CHECK:       bb.0:
# CHECK-NEXT:    successors: %bb.2(
# CHECK:         TCRETURN_NZ_nn &g, implicit $sp, implicit $flags, implicit $hl
# CHECK-NOT:   bb.1:
# CHECK:       bb.2:
name: over_tail_call
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $a, $hl

    OR_r $a, implicit-def $a, implicit-def $flags, implicit $a
    JR_Z_e %bb.2, implicit $flags

  bb.1:
    liveins: $hl

    TCRETURN_nn &g, implicit-def dead $a, implicit-def dead $bc, implicit-def dead $de, implicit-def dead $hl, implicit-def $iy, implicit-def $flags, implicit $sp, implicit $hl

  bb.2:
    RET
...
---
# The trampoline collapses into JP Z, which then becomes RET Z.
# CHECK-LABEL: name: trampoline
# CHECK:       bb.0:
# CHECK:         RET_Z implicit $flags
# CHECK-NOT:   bb.1:
# CHECK:       bb.2:
name: trampoline
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $a, $l

    OR_r $a, implicit-def $a, implicit-def $flags, implicit $a
    JR_NZ_e %bb.2, implicit $flags

  bb.1:
    successors: %bb.3

    JP_nn %bb.3

  bb.2:
    successors: %bb.3
    liveins: $l

    $a = LD_r_r $l

  bb.3:
    RET
...
