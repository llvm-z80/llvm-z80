# RUN: llc -verify-machineinstrs -mtriple=z80 -run-pass=z80-pre-emit-peephole %s -o - | FileCheck %s
#
# DEC HL ... INC HL with no use of HL between them cancels out.

---
name:            across_spill
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $bc, $hl, $ix
    $hl = DEC_rr $hl
    LD_IXd_r -8, $c, implicit $ix
    LD_IXd_r -7, $b, implicit $ix
    $hl = INC_rr $hl
    $a = LD_r_HLind implicit $hl
    RET implicit $a

# CHECK-LABEL: name: across_spill
# CHECK-NOT:   DEC_rr
# CHECK:       LD_IXd_r -8
# CHECK-NEXT:  LD_IXd_r -7
# CHECK-NEXT:  $a = LD_r_HLind

...
---
name:            nested
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $hl
    $hl = DEC_rr $hl
    $hl = DEC_rr $hl
    $hl = INC_rr $hl
    $hl = INC_rr $hl
    $a = LD_r_HLind implicit $hl
    RET implicit $a

# CHECK-LABEL: name: nested
# CHECK-NOT:   _rr
# CHECK:       $a = LD_r_HLind

...
---
name:            hl_read_between
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $hl
    $hl = DEC_rr $hl
    $c = LD_r_HLind implicit $hl
    $hl = INC_rr $hl
    $a = LD_r_HLind implicit $hl
    RET implicit $a, implicit $c

# CHECK-LABEL: name: hl_read_between
# CHECK:       DEC_rr
# CHECK-NEXT:  $c = LD_r_HLind
# CHECK-NEXT:  INC_rr

...
---
name:            l_written_between
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $a, $hl
    $hl = DEC_rr $hl
    $l = LD_r_r $a
    $hl = INC_rr $hl
    $a = LD_r_HLind implicit $hl
    RET implicit $a

# CHECK-LABEL: name: l_written_between
# CHECK:       DEC_rr
# CHECK-NEXT:  $l = LD_r_r
# CHECK-NEXT:  INC_rr

...
