# RUN: llc -mtriple=z80 -run-pass=instruction-select -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=sm83 -run-pass=instruction-select -verify-machineinstrs %s -o - | FileCheck %s

# A COPY into a class narrower than the default describes one use of the
# value. The value keeps the default class and the COPY stays, so the other
# uses are not held to the narrower class.

---
name: narrow_pair_copy
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: narrow_pair_copy
    ; CHECK:      [[V:%[0-9]+]]:gr16 = LD_rr_nn 16
    ; CHECK-NEXT: $hl = COPY [[V]]
    ; CHECK-NEXT: [[N:%[0-9]+]]:gr16_bcde = COPY [[V]]
    ; CHECK-NEXT: $bc = COPY [[N]]
    %0:any(s16) = G_CONSTANT i16 16
    $hl = COPY %0(s16)
    %1:gr16_bcde = COPY %0(s16)
    $bc = COPY %1
    RET implicit $bc, implicit $hl
...
---
name: narrow_byte_copy
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: narrow_byte_copy
    ; CHECK:      [[V:%[0-9]+]]:gr8 = LD_r_n 5
    ; CHECK-NEXT: $l = COPY [[V]]
    ; CHECK-NEXT: [[N:%[0-9]+]]:ac = COPY [[V]]
    ; CHECK-NEXT: $a = COPY [[N]]
    %0:any(s8) = G_CONSTANT i8 5
    $l = COPY %0(s8)
    %1:ac = COPY %0(s8)
    $a = COPY %1
    RET implicit $a, implicit $l
...
