# RUN: llc -verify-machineinstrs -mtriple=z80 -start-before=prolog-epilog -stop-after=postrapseudos %s -o - | FileCheck %s
#
# A frame slot that resolves to an IX displacement leaves the pair spill for the
# post-RA expansion to split, which must reach the same conclusion about the
# half that holds nothing.

--- |
  define void @expanded_after_frame_layout() "frame-pointer"="all" { ret void }
...
---
name:            expanded_after_frame_layout
tracksRegLiveness: true
frameInfo:
  hasCalls:      true
stack:
  - { id: 0, size: 2, alignment: 1 }
body:             |
  bb.0:
    liveins: $a, $ix
    renamable $e = COPY $a
    SPILL_ANY16 renamable $de, %stack.0, 0 :: (store (s16) into %stack.0, align 1)
    RET
...
---
# The frame slot resolves to an IX displacement, and the pseudo survives to the
# post-RA expansion that splits it.
# CHECK-LABEL: name: expanded_after_frame_layout
# CHECK:      LD_IXd_E {{-?[0-9]+}}, implicit $e
# CHECK-NEXT: LD_IXd_D {{-?[0-9]+}}, implicit undef $d
