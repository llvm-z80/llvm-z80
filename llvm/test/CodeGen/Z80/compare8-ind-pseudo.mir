# RUN: llc -verify-machineinstrs -mtriple=z80 -run-pass=post-ra-pseudos %s -o - | FileCheck %s
#
# COMPARE8_IND compares A with the byte its address operand points to. The
# address is constrained to HL (GR16_HL), the only pair CP (HL) can use, so
# after register allocation the pseudo is exactly one CP (HL) with no operand
# of its own.

--- |
  define void @compare_ind() { ret void }
  define void @compare_ind_flags_dead() { ret void }
...
---
name:            compare_ind
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $a, $hl
    COMPARE8_IND $a, $hl, implicit-def $flags
    JP_Z_nn %bb.1, implicit $flags
  bb.1:
    RET

# CHECK-LABEL: name: compare_ind
# CHECK-NOT:   COMPARE8_IND
# CHECK:       CP_HLind implicit-def $flags, implicit $a, implicit $hl
# CHECK-NEXT:  JP_Z_nn %bb.1, implicit $flags

...
---
name:            compare_ind_flags_dead
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $a, $hl
    COMPARE8_IND $a, $hl, implicit-def dead $flags
    RET

# The pseudo's flags result is dead, and the expansion keeps it that way.

# CHECK-LABEL: name: compare_ind_flags_dead
# CHECK-NOT:   COMPARE8_IND
# CHECK:       CP_HLind implicit-def dead $flags, implicit $a, implicit $hl
# CHECK-NEXT:  RET

...
