# RUN: llc -verify-machineinstrs -mtriple=z80 -run-pass=z80-late-opt %s -o - | FileCheck %s
#
# OR or XOR against a register holding zero leaves A exactly as it was, so
# all such an instruction really does is set flags. Where those are dead too
# it does nothing, and dropping it leaves the constant that fed it dead.

--- |
  define void @zero_operand() { ret void }
  define void @flags_live() { ret void }
...
---
name:            zero_operand
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $a
    LD_L_n 0, implicit-def $l
    OR_L implicit-def $a, implicit-def $flags, implicit $a, implicit $l
    LD_IXd_A -2, implicit $a, implicit $ix
    RET

# CHECK-LABEL: name: zero_operand
# CHECK-NOT:  LD_L_n
# CHECK-NOT:  OR_L
# CHECK:      LD_IXd_A

...
---
name:            flags_live
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $a
    LD_L_n 0, implicit-def $l
    OR_L implicit-def $a, implicit-def $flags, implicit $a, implicit $l
    JP_Z_nn %bb.1, implicit $flags
  bb.1:
    RET

# The flags are the whole point here, so the instruction stays.

# CHECK-LABEL: name: flags_live
# CHECK:      LD_L_n 0
# CHECK-NEXT: OR_L
# CHECK-NEXT: JP_Z_nn

...
