    $bc = LD_rr_nn 0
    $bc = LD_rr_nn 0
    $bc = LD_rr_nn 0
    ADC_HL_rr_CIO $de, $a, implicit-def $hl, implicit-def $a, implicit-def $flags, implicit $hl

  bb.2:
    liveins: $bc, $de, $hl
    RET
...
