    liveins: $bc, $de, $hl
    RET
...

# 40 * 3 B = 120 B padding.
# On SM83, SUB_HL_rr_BO is 9 B -> total distance 129 B > 127 B -> must relax to JP_Z_nn.
# On Z80, SUB_HL_rr_BO is 6 B -> total distance 126 B <= 127 B -> must stay JR_Z_e.
# SM83-LABEL: name: sm83_sub_hl_rr_bo_boundary
# SM83:       bb.0:
# SM83:         JP_Z_nn %bb.2
# Z80-LABEL:  name: sm83_sub_hl_rr_bo_boundary
# Z80:        bb.0:
# Z80:          JR_Z_e %bb.2

# 39 * 3 B = 117 B padding.
# On SM83, ADC_HL_rr_CIO is 11 B -> total distance 128 B > 127 B -> must relax to JP_Z_nn.
# On Z80, ADC_HL_rr_CIO is 7 B -> total distance 124 B <= 127 B -> must stay JR_Z_e.
# SM83-LABEL: name: sm83_adc_hl_rr_cio_boundary
# SM83:       bb.0:
# SM83:         JP_Z_nn %bb.2
# Z80-LABEL:  name: sm83_adc_hl_rr_cio_boundary
# Z80:        bb.0:
# Z80:          JR_Z_e %bb.2

# 39 * 3 B = 117 B padding.
# On SM83, SBC_HL_rr_BIO is 11 B -> total distance 128 B > 127 B -> must relax to JP_Z_nn.
# On Z80, SBC_HL_rr_BIO is 7 B -> total distance 124 B <= 127 B -> must stay JR_Z_e.
# SM83-LABEL: name: sm83_sbc_hl_rr_bio_boundary
# SM83:       bb.0:
# SM83:         JP_Z_nn %bb.2
# Z80-LABEL:  name: sm83_sbc_hl_rr_bio_boundary
# Z80:        bb.0:
# Z80:          JR_Z_e %bb.2

# 41 * 3 B = 123 B padding.
# On SM83, SUB_HL_rr is 6 B -> total distance 129 B > 127 B -> must relax to JP_Z_nn.
# On Z80, SUB_HL_rr is 3 B -> total distance 126 B <= 127 B -> must stay JR_Z_e.
# SM83-LABEL: name: sm83_sub_hl_rr_boundary
# SM83:       bb.0:
# SM83:         JP_Z_nn %bb.2
# Z80-LABEL:  name: sm83_sub_hl_rr_boundary
# Z80:        bb.0:
# Z80:          JR_Z_e %bb.2

# 41 * 3 B = 123 B padding.
# On SM83, SADD_HL_rr is 6 B -> total distance 129 B > 127 B -> must relax to JP_Z_nn.
# On Z80, SADD_HL_rr is 3 B -> total distance 126 B <= 127 B -> must stay JR_Z_e.
# SM83-LABEL: name: sm83_sadd_hl_rr_boundary
# SM83:       bb.0:
# SM83:         JP_Z_nn %bb.2
# Z80-LABEL:  name: sm83_sadd_hl_rr_boundary
# Z80:        bb.0:
# Z80:          JR_Z_e %bb.2
