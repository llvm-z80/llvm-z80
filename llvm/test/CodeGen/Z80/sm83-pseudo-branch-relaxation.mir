tracksRegLiveness: true
body: |
  bb.0:
    liveins: $a, $bc, $de, $hl, $flags
    JR_Z_e %bb.2, implicit $flags

  bb.1:
    liveins: $a, $bc, $de, $hl
    $bc = LD_rr_nn 0
    $bc = LD_rr_nn 0
    $bc = LD_rr_nn 0
