@LIT_SITE_CFG_IN_HEADER@

config.llvm_tools_dir = lit_config.substitute(path(r"@LLVM_TOOLS_DIR@"))
config.targets_to_build = "@Z80_TEST_TARGETS_TO_BUILD@"
config.z80_e2e_obj_root = path(r"@Z80_E2E_OBJ_ROOT@")
config.z80_cpu = "@Z80_E2E_CPU@"
config.z80_opt = "@Z80_E2E_OPT@"
config.z80_variant = "@Z80_E2E_VARIANT@"
config.z80_format = "@Z80_E2E_FORMAT@"
config.z80_clang_flags = "@Z80_E2E_CLANG_FLAGS@"
config.z80_llc_flags = "@Z80_E2E_LLC_FLAGS@"

import lit.llvm
lit.llvm.initialize(lit_config, config)

lit_config.load_config(config, os.path.join(path(r"@Z80_E2E_SOURCE_DIR@"), "lit.cfg.py"))
